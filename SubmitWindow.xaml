<Window x:Class="Skein.SubmitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Skein"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="New post" Width="940" Height="680" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <local:VisibilityConverter x:Key="VisConverter" />
    </Window.Resources>
    <DockPanel Margin="20">
        <!-- A draft from last time, put back. -->
        <Border x:Name="DraftBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="10,6" Margin="0,0,0,12"
                CornerRadius="6" Background="#22808080">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Discard draft" Click="OnDiscardDraft" />
                <TextBlock Text="📝 Your unfinished post is back, just as you left it." VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="LaterButton" Content="🕒 Post later…" MinWidth="90" Margin="0,0,8,0" Click="OnPostLater"
                        ToolTip="Pick a time and Skein posts it then (text and link posts, while Skein is running)" />
                <Button x:Name="PostButton" Content="Post" MinWidth="90" Click="OnPost"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <!-- The community's rules, once it's known. -->
        <Border x:Name="RulesPanel" DockPanel.Dock="Right" Width="250" Margin="16,0,0,0" Padding="12,10" CornerRadius="8"
                Background="#14808080" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="RulesHeading" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CommunityRule}">
                                <Expander Margin="0,2">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                                               Margin="4,2,0,6" />
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Community" Margin="0,0,0,4" />
            <DockPanel>
                <TextBlock Text="r/" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF4500" Margin="0,0,6,0" />
                <TextBox x:Name="Subreddit" TextChanged="OnSubredditChanged" />
            </DockPanel>

            <!-- Post flair, when the community has some. -->
            <DockPanel x:Name="FlairRow" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="Flair" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="FlairText" DockPanel.Dock="Right" Width="180" Margin="8,0,0,0" Visibility="Collapsed"
                         ToolTip="This flair's text can be changed" MaxLength="64" />
                <ComboBox x:Name="Flair" MinWidth="200" HorizontalAlignment="Left" SelectionChanged="OnFlairChanged" />
            </DockPanel>
            <TextBlock x:Name="CommunityNote" Margin="0,4,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock Text="Title" Margin="0,12,0,4" />
            <TextBox x:Name="PostTitle" MaxLength="300" SpellCheck.IsEnabled="True" TextChanged="OnChanged" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton x:Name="TextKind" Content="Text post" IsChecked="True" Checked="OnKindChanged" />
                <RadioButton x:Name="LinkKind" Content="Link" Margin="16,0,0,0" Checked="OnKindChanged" />
                <RadioButton x:Name="MediaKind" Content="Images &amp; video" Margin="16,0,0,0" Checked="OnKindChanged" />
                <CheckBox x:Name="Nsfw" Content="NSFW" Margin="24,0,0,0" Click="OnChanged" />
                <CheckBox x:Name="Spoiler" Content="Spoiler" Margin="12,0,0,0" Click="OnChanged" />
            </StackPanel>

            <TextBlock x:Name="ContentLabel" Text="Text" Margin="0,12,0,4" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:MarkdownToolbar x:Name="Formatting" Target="{Binding ElementName=Body}" />
            <TextBox Grid.Row="1" x:Name="Body" SpellCheck.IsEnabled="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" TextChanged="OnChanged"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            <!-- The post view's editor (toolbar, Markdown or rich text), when it's available. -->
            <wv2:WebView2 x:Name="RichBody" Grid.RowSpan="2" Visibility="Collapsed" />

            <!-- Pictures (one, or up to 20 as a gallery) or a single video. -->
            <DockPanel x:Name="MediaPanel" Grid.RowSpan="2" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="+ Add pictures or a video…" Click="OnAddMedia" />
                    <TextBlock x:Name="MediaHint" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                               Text="Or drop files here. One picture, up to 20 as a gallery, or one video." />
                </DockPanel>
                <ListBox x:Name="MediaList" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SubmitMedia}">
                            <DockPanel Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" ToolTip="Remove" Click="OnRemoveMedia" Tag="{Binding}" />
                                <Button DockPanel.Dock="Right" Content="✎ Crop or blur" Padding="8,2" Margin="0,0,6,0" Click="OnEditMedia" Tag="{Binding}"
                                        ToolTip="Crop, rotate, or blur faces, plates and names before posting"
                                        Visibility="{Binding CanEdit, Converter={StaticResource VisConverter}}" />
                                <Border Width="72" Height="54" CornerRadius="4" ClipToBounds="True" Background="#22808080" Margin="0,0,10,0">
                                    <Grid>
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                        <TextBlock Text="🎬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsVideo, Converter={StaticResource VisConverter}}" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" MaxLength="180"
                                             ToolTip="Caption (galleries only)"
                                             Visibility="{Binding DataContext.ShowCaptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisConverter}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
