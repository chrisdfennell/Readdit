<Window x:Class="Skein.QuickReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick reply · Skein" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual" Icon="Assets/skein.ico">
    <StackPanel Margin="18,14">
        <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="Context" Opacity="0.65" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="#14808080">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Body" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <TextBox x:Name="Reply" Margin="0,12,0,0" MinHeight="80" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="OnReplyKeyDown" />
        <TextBlock Text="Markdown works. Ctrl+Enter sends." FontSize="11" Opacity="0.55" Margin="2,4,0,0" />
        <TextBlock x:Name="Status" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <DockPanel Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open in Skein" Click="OnOpen" />
                <Button x:Name="MarkReadButton" Content="Mark as read" Margin="8,0,0,0" Click="OnMarkRead" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SendButton" Content="Send" MinWidth="80" Click="OnSend" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Close" MinWidth="70" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
