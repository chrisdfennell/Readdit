<Window x:Class="Skein.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Skein" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22,20">
        <TextBlock Text="Keep Skein running in the tray?" FontSize="16" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.8"
                   Text="In the tray, Skein keeps checking for new messages and can notify you. You can open it again from the tray icon, or exit from its menu." />

        <CheckBox x:Name="Remember" Content="Don't ask again (change this later in Preferences)" Margin="0,16,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="TrayButton" Content="Minimize to tray" MinWidth="130" IsDefault="True" Click="OnTray"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Exit Skein" MinWidth="110" Margin="8,0,0,0" Click="OnExit" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
