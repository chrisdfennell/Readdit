<Window x:Class="Skein.ComposeMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New message" Width="560" Height="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="To" />
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="u/" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" />
                <TextBox x:Name="To" MaxLength="40" />
            </DockPanel>
            <TextBlock Text="Subject" Margin="0,12,0,4" />
            <TextBox x:Name="Subject" MaxLength="100" SpellCheck.IsEnabled="True" />
            <TextBlock Text="Message (Markdown supported)" Margin="0,12,0,4" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SendButton" Content="Send" MinWidth="90" IsDefault="False" Click="OnSend"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <TextBox x:Name="Body" AcceptsReturn="True" TextWrapping="Wrap" SpellCheck.IsEnabled="True"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="OnBodyKeyDown" />
    </DockPanel>
</Window>
