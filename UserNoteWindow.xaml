<Window x:Class="Skein.UserNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="Only you see these. They're kept on this PC." FontSize="12" Opacity="0.65" Margin="0,2,0,0" />
        <TextBlock Text="Tag (shown next to their name)" Margin="0,14,0,0" />
        <TextBox x:Name="TagBox" Margin="0,6,0,0" MaxLength="40" />
        <TextBlock Text="Note" Margin="0,12,0,0" />
        <TextBox x:Name="NoteBox" SpellCheck.IsEnabled="True" Margin="0,6,0,0" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        <DockPanel Margin="0,16,0,0">
            <Button Content="Clear" Click="OnClear" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" MinWidth="80" IsDefault="True" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
