<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Skein</RootNamespace>
    <AssemblyName>Skein</AssemblyName>
    <!-- Fluent ThemeMode is flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\skein.ico</ApplicationIcon>
    <!-- Custom Main so Velopack's installer hooks run before WPF starts. -->
    <StartupObject>Skein.Program</StartupObject>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests are their own project under tests/; don't compile them into the app. -->
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="Skein.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of global scope so WPF type names stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\skein.ico" />
    <!-- The post view is a local web page served to WebView2 from the output folder. -->
    <None Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
