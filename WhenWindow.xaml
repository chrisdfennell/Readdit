<Window x:Class="Skein.WhenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock x:Name="Subject" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="40" />
        <!-- Quick choices: one click picks and closes. -->
        <ItemsControl x:Name="Choices" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button HorizontalContentAlignment="Stretch" Margin="0,2" Padding="10,6" Click="OnChoice" Tag="{Binding Key}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Opacity="0.6" />
                            <TextBlock Text="{Binding Label}" />
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Or pick a day and time:" Margin="0,12,0,4" />
        <DockPanel>
            <TextBox x:Name="TimeBox" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" ToolTip="A time, like 9:30 or 7pm"
                     VerticalContentAlignment="Center" />
            <DatePicker x:Name="DateBox" />
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOk" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
