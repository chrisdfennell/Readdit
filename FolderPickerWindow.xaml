<Window x:Class="Skein.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to folder" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" />
        <ComboBox x:Name="Folder" Margin="0,8,0,0" IsEditable="True" />
        <TextBlock Text="Pick a folder, or type a new name to create one." FontSize="12" Opacity="0.65" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add" MinWidth="80" IsDefault="True" Click="OnOk" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
