<Window x:Class="Skein.ReportProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a problem" Width="540" Height="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="What went wrong?" FontSize="16" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,10"
                   Text="Describe what you were doing and what happened. Skein puts this, its version and (if you like) its logs in a zip on your desktop, then opens a new issue on GitHub for you to attach it to." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Content="Just open GitHub" Click="OnIssueOnly" ToolTip="Open a new issue without making a zip" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CreateButton" Content="Create report" MinWidth="120" IsDefault="True" Click="OnCreate"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <CheckBox DockPanel.Dock="Bottom" x:Name="IncludeLogs" IsChecked="True" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="Include Skein's logs: the crash log, and which requests went to Reddit with their status codes. Your username and Windows user folder are replaced, and nothing Reddit sent back is included." />
        </CheckBox>

        <TextBox x:Name="Description" AcceptsReturn="True" TextWrapping="Wrap" SpellCheck.IsEnabled="True"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
    </DockPanel>
</Window>
