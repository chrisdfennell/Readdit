<Window x:Class="Skein.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Skein"
        Title="{Binding SelectedTab.Title, StringFormat={}{0} · Skein mini, FallbackValue=Skein mini}"
        Icon="Assets/skein.ico" Width="380" Height="640" MinWidth="280" MinHeight="300"
        WindowStartupLocation="Manual" ShowInTaskbar="True">
    <Window.Resources>
        <local:VisibilityConverter x:Key="Vis" />
        <local:UrlToImageConverter x:Key="UrlToImage" />
        <Style x:Key="MiniGlyph" TargetType="Button">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="⟳" Style="{StaticResource MiniGlyph}" ToolTip="Refresh (F5)"
                        Command="{Binding SelectedTab.ShowNewCommand}" />
                <ToggleButton x:Name="PinButton" Content="📌" MinWidth="32" Padding="6,2" Margin="4,0,0,0"
                              ToolTip="Keep on top of other windows" Click="OnPinClicked" />
                <Button Content="⤢" Style="{StaticResource MiniGlyph}" ToolTip="Back to the full window (Ctrl+M)"
                        Click="OnFullWindow" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ToolTip="Which tab to watch">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FeedViewModel}">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" Opacity="0.6" Margin="10,2,10,6"
                   TextTrimming="CharacterEllipsis" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar IsIndeterminate="True" Height="2"
                         Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />

            <ListBox x:Name="Posts" Grid.Row="1" ItemsSource="{Binding SelectedTab.Posts}" SelectedItem="{Binding SelectedTab.SelectedPost}"
                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="OnOpenPost" KeyDown="OnListKeyDown" ScrollViewer.ScrollChanged="OnScrollChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:Post}">
                        <DockPanel Margin="0,4" ToolTip="{Binding Title}">
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0"
                                    VerticalAlignment="Top" Visibility="{Binding Thumbnail, Converter={StaticResource Vis}}">
                                <Image Stretch="UniformToFill"
                                       Source="{Binding Thumbnail, Converter={StaticResource UrlToImage}, ConverterParameter=88}" />
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"
                                           MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ShortMeta}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding ScoreText, StringFormat=▲ {0}}" FontSize="11" Opacity="0.75" />
                                    <TextBlock Text="{Binding CommentsText}" FontSize="11" Opacity="0.75" Margin="10,0,0,0"
                                               Visibility="{Binding IsLink, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding NewCommentsText}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Foreground="{DynamicResource Accent}"
                                               Visibility="{Binding HasNewComments, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                <Setter TargetName="TitleText" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in Skein" InputGestureText="Enter" Click="OnOpenPost" />
                        <MenuItem Header="Open link in your browser" Click="OnOpenInBrowser" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- "↑ 5 new posts", over the top of the list. -->
            <Button Grid.Row="1" Content="{Binding SelectedTab.NewPostsLabel}" Command="{Binding SelectedTab.ShowNewCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Cursor="Hand"
                    Visibility="{Binding SelectedTab.HasNewPosts, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Accent}" CornerRadius="12" Padding="12,4">
                            <ContentPresenter TextElement.Foreground="White" TextElement.FontWeight="SemiBold" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Row="2" Content="Load more" Margin="8,4" HorizontalAlignment="Stretch"
                    Command="{Binding SelectedTab.LoadMoreCommand}"
                    Visibility="{Binding SelectedTab.HasMore, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
        </Grid>
    </DockPanel>
</Window>
