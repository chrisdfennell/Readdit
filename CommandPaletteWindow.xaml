<Window x:Class="Skein.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Skein"
        Title="Go to" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border BorderThickness="1" BorderBrush="#40808080" Padding="8">
        <StackPanel>
            <Grid>
                <TextBox x:Name="Query" FontSize="15" Padding="6,4" VerticalContentAlignment="Center"
                         TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
                <TextBlock Text="Go to a community, folder or tab, or run a command…" Margin="12,0,0,0" FontSize="15"
                           VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False" x:Name="Placeholder" />
            </Grid>
            <ListBox x:Name="Results" Margin="0,8,0,0" MaxHeight="420" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch" MouseUp="OnResultClicked"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PaletteItem}">
                        <DockPanel Margin="2,3">
                            <TextBlock Text="{Binding Glyph}" Width="26" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Opacity="0.55" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,4,0" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Hint" Margin="4,6,0,0" FontSize="11" Opacity="0.5"
                       Text="↑↓ to choose · Enter to open · Esc to close" />
        </StackPanel>
    </Border>
</Window>
