<Window x:Class="Skein.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences" Width="980" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- One setting: a softly shaded card. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#10808080" />
            <Setter Property="BorderBrush" Value="#18808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- Help text under a checkbox lines up with the checkbox's label. -->
        <Style x:Key="CheckHelp" TargetType="TextBlock" BasedOn="{StaticResource Help}">
            <Setter Property="Margin" Value="28,2,0,0" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageIntro" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Padding" Value="28,20,28,20" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="ListBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Categories, with a search over every setting. -->
        <DockPanel Grid.RowSpan="2" Background="#0A808080">
            <Grid DockPanel.Dock="Top" Margin="14,16,14,10">
                <TextBox x:Name="Search" TextChanged="OnSearchChanged" VerticalContentAlignment="Center"
                         ToolTip="Find a setting (Ctrl+F)" AutomationProperties.Name="Find a setting" />
                <TextBlock Text="🔍 Find a setting" IsHitTestVisible="False" Opacity="0.5" Margin="10,0,0,0" VerticalAlignment="Center"
                           x:Name="SearchHint" />
            </Grid>
            <TextBlock x:Name="NoMatches" DockPanel.Dock="Top" Text="No settings match." Opacity="0.6" Margin="18,4,14,0" Visibility="Collapsed" />
            <ListBox x:Name="Nav" SelectionChanged="OnPageChanged" BorderThickness="0" Background="Transparent" Margin="6,0,6,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Settings categories">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- The pages. -->
        <Grid Grid.Column="1">

            <!-- ==== Appearance ==== -->
            <ScrollViewer x:Name="PageAppearance" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="How Skein looks." Style="{StaticResource PageIntro}" />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox x:Name="Theme" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Theme" Style="{StaticResource Title}" />
                                <TextBlock Text="System follows Windows. Black is true black for OLED screens; High contrast is white on black with bright highlights." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox x:Name="Accent" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Accent colour" Style="{StaticResource Title}" />
                                <TextBlock Text="Used for highlights, buttons and new-comment markers." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="UiScale" Width="200" Minimum="80" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" AutomationProperties.Name="Interface size" />
                                <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Value, ElementName=UiScale, StringFormat={}{0:0}%}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Interface size" Style="{StaticResource Title}" />
                                <TextBlock Text="The sidebar, post list and toolbar." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Posts and comments" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="ReadingSize" Width="200" Minimum="12" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" AutomationProperties.Name="Text size" />
                                <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Value, ElementName=ReadingSize, StringFormat={}{0:0}px}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Text size" Style="{StaticResource Title}" />
                                <TextBlock Text="Also + and − while reading." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox x:Name="ReadingFont" DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" AutomationProperties.Name="Font">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Font" Style="{StaticResource Title}" />
                                <TextBlock Text="Any font installed on this PC." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Your own styles" Style="{StaticResource Title}" />
                            <TextBlock Text="Advanced: CSS added to the post view, for example  .comment { margin-top: 4px; }   Leave empty for none." Style="{StaticResource Help}" />
                            <TextBox x:Name="CustomCss" AcceptsReturn="True" AcceptsTab="True" Height="110" Margin="0,10,0,0"
                                     FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Your own styles" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Feeds ==== -->
            <ScrollViewer x:Name="PageFeeds" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Feeds" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="How lists of posts behave." Style="{StaticResource PageIntro}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CheckForNewPosts" Content="Check for new posts" />
                            <TextBlock Text="Every 90 seconds, the feed you're looking at checks for new posts and offers to show them." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="HideDuplicates" Content="Show a link posted in several communities once" />
                            <TextBlock Text="In Home, Popular, All, folders and search, marked with where else it was posted." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="HideRead" Content="Hide posts I've already opened" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox x:Name="SleepTabs" DockPanel.Dock="Right" Width="160" VerticalAlignment="Center" AutomationProperties.Name="Let background tabs sleep after">
                                <ComboBoxItem Content="5 minutes" Tag="5" />
                                <ComboBoxItem Content="15 minutes" Tag="15" />
                                <ComboBoxItem Content="30 minutes" Tag="30" />
                                <ComboBoxItem Content="1 hour" Tag="60" />
                                <ComboBoxItem Content="Never" Tag="0" />
                            </ComboBox>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Let background tabs sleep after" Style="{StaticResource Title}" />
                                <TextBlock Text="Sleeping tabs let go of their posts to save memory, and reload when you open them." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Filters ==== -->
            <ScrollViewer x:Name="PageFilters" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Filters" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="What you'd rather not see. Lists apply to Home, Popular, All, multireddits and search." Style="{StaticResource PageIntro}" />

                    <TextBlock Text="NSFW and spoilers" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="BlurNsfw" Content="Blur NSFW and spoiler pictures until clicked" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="HideNsfw" Content="Hide NSFW posts" />
                            <TextBlock Text="In Home, Popular, All and search." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Scores" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBox x:Name="MinScore" DockPanel.Dock="Right" Width="100" VerticalAlignment="Center" AutomationProperties.Name="Hide posts scoring below" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Hide posts scoring below" Style="{StaticResource Title}" />
                                <TextBlock Text="Leave empty to show every post." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBox x:Name="CollapseBelow" DockPanel.Dock="Right" Width="100" VerticalAlignment="Center" AutomationProperties.Name="Collapse comments scoring at or below" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Collapse comments scoring at or below" Style="{StaticResource Title}" />
                                <TextBlock Text="They're folded away; click to open one. Leave empty to show them all." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Hide posts" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="With these words in the title" Style="{StaticResource Title}" />
                            <TextBlock Text="One per line." Style="{StaticResource Help}" />
                            <TextBox x:Name="Keywords" Style="{StaticResource ListBox}" AutomationProperties.Name="Hide posts with these words in the title" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Linking to these sites" Style="{StaticResource Title}" />
                            <TextBlock Text="One per line, like example.com." Style="{StaticResource Help}" />
                            <TextBox x:Name="Domains" Style="{StaticResource ListBox}" AutomationProperties.Name="Hide posts linking to these sites" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="From these communities" Style="{StaticResource Title}" />
                            <TextBlock Text="One per line, without r/." Style="{StaticResource Help}" />
                            <TextBox x:Name="Subreddits" Style="{StaticResource ListBox}" AutomationProperties.Name="Hide posts from these communities" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== People ==== -->
            <ScrollViewer x:Name="PagePeople" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="People" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Usernames, one per line (u/ is optional). You can also mute, highlight or tag someone from the ⋯ next to their comments."
                               Style="{StaticResource PageIntro}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Muted" Style="{StaticResource Title}" />
                            <TextBlock Text="Their posts are hidden and their comments collapsed." Style="{StaticResource Help}" />
                            <TextBox x:Name="MutedUsers" Style="{StaticResource ListBox}" Height="130" AutomationProperties.Name="Muted users" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Highlighted" Style="{StaticResource Title}" />
                            <TextBlock Text="Their posts are tagged and their comments stand out." Style="{StaticResource Help}" />
                            <TextBox x:Name="HighlightedUsers" Style="{StaticResource ListBox}" Height="130" AutomationProperties.Name="Highlighted users" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Notifications and window ==== -->
            <ScrollViewer x:Name="PageWindow" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Notifications and window" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="What Skein tells you about, and what happens when you close it." Style="{StaticResource PageIntro}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="InboxNotifications" Content="Notify me about new replies and messages" />
                            <TextBlock Text="You can reply or mark them read right in the notification. Alerts and reminders have their own settings in 🔔 Alerts." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox x:Name="CloseAction" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" AutomationProperties.Name="When I close the window">
                                <ComboBoxItem Content="Ask me" Tag="Ask" />
                                <ComboBoxItem Content="Minimize to the tray" Tag="Tray" />
                                <ComboBoxItem Content="Exit Skein" Tag="Exit" />
                            </ComboBox>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="When I close the window" Style="{StaticResource Title}" />
                                <TextBlock Text="In the tray, Skein keeps checking for messages, alerts and reminders." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Links and sharing ==== -->
            <ScrollViewer x:Name="PageLinks" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Links and sharing" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Where links open, and getting things into Skein from other apps." Style="{StaticResource PageIntro}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="OpenLinksInApp" Content="Open links inside Skein" />
                            <TextBlock Text="In Skein's own browser pane, instead of your default browser." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Links from other apps" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Open reddit links in Skein" Style="{StaticResource Title}" />
                            <TextBlock Text="Make Skein the app Windows uses for web links. Reddit links (from Discord, email, anywhere) then open in Skein, and every other link goes straight on to your usual browser."
                                       Style="{StaticResource Help}" />
                            <TextBlock x:Name="LinkHandlerStatus" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="LinkHandlerSetUp" Content="Set up…" Click="OnSetUpLinkHandler" />
                                <Button x:Name="LinkHandlerUndo" Content="Stop opening links" Margin="8,0,0,0" Click="OnUndoLinkHandler" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Share to Skein" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SendTo" Content="Add Skein to Explorer's Send to menu" />
                            <TextBlock Text="Right-click pictures or a video, choose Send to → Skein, and a new post starts with them." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="📋 Copy bookmark" VerticalAlignment="Center" Click="OnCopyBookmarklet" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="The “Post to Skein” bookmark" Style="{StaticResource Title}" />
                                <TextBlock Text="Add it to your browser's bookmarks bar (paste it as the bookmark's address). Click it on any page to post that page's link."
                                           Style="{StaticResource Help}" />
                                <TextBlock x:Name="ShareStatus" Style="{StaticResource Status}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Translation and summaries ==== -->
            <ScrollViewer x:Name="PageLanguage" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Translation and summaries" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Both are optional and off until you turn them on. They send text to an outside service." Style="{StaticResource PageIntro}" />

                    <TextBlock Text="🌐 Translation" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="TranslateEnabled" Content="Offer Translate on posts and comments" />
                            <TextBlock Text="The text you translate is sent to the translation service below." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox x:Name="TranslateTo" DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" AutomationProperties.Name="Translate into" />
                            <TextBlock Text="Translate into" Style="{StaticResource Title}" Margin="0,0,16,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Translation service" Style="{StaticResource Title}" />
                            <TextBlock Text="MyMemory (free, no account, a few thousand words a day), unless you give a LibreTranslate server here." Style="{StaticResource Help}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Server (empty for MyMemory)" Style="{StaticResource Help}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TranslateServer" ToolTip="e.g. https://libretranslate.example.com" AutomationProperties.Name="LibreTranslate server" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="API key, if it needs one" Style="{StaticResource Help}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TranslateKey" AutomationProperties.Name="LibreTranslate API key" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="✨ Thread summaries" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Anthropic API key" Style="{StaticResource Title}" />
                            <TextBlock Text="✨ Summarize sends a thread's post and comments to Claude with your own key (from console.anthropic.com). Anthropic bills your account for each summary: usually a few cents up to about 15 cents for a big thread with Opus, and a small fraction of that with Haiku."
                                       Style="{StaticResource Help}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="ForgetKey" DockPanel.Dock="Right" Content="Forget key" Margin="8,0,0,0" Click="OnForgetKey" />
                                <PasswordBox x:Name="SummaryKey" ToolTip="Starts with sk-ant-. Kept encrypted for your Windows account."
                                             AutomationProperties.Name="Anthropic API key" />
                            </DockPanel>
                            <TextBlock x:Name="SummaryStatus" Style="{StaticResource Status}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox x:Name="SummaryModel" DockPanel.Dock="Right" Width="280" VerticalAlignment="Center" AutomationProperties.Name="Summary model" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Model" Style="{StaticResource Title}" />
                                <TextBlock Text="Which Claude writes the summaries." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Library and downloads ==== -->
            <ScrollViewer x:Name="PageLibrary" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Library and downloads" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Posts you keep, and where downloads go." Style="{StaticResource PageIntro}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SaveOffline" Content="Keep an offline copy of posts I save" />
                            <TextBlock Text="With their comments, pictures and video, in 📥 Offline library." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Save downloaded pictures and videos to" Style="{StaticResource Title}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseDownloadFolder" />
                                <TextBox x:Name="DownloadFolder" AutomationProperties.Name="Download folder" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Sync and backup ==== -->
            <ScrollViewer x:Name="PageSync" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Sync and backup" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Keep your setup the same on every PC, and safe in one file." Style="{StaticResource PageIntro}" />

                    <TextBlock Text="Sync between PCs" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SyncEnabled" Content="Sync through a shared folder" />
                            <TextBlock Text="Folders, saved searches, alerts, reminders, saved replies, user notes, filters and appearance stay the same on every PC that uses the folder."
                                       Style="{StaticResource CheckHelp}" />
                            <TextBlock Text="Folder (a OneDrive folder works well)" Style="{StaticResource Help}" Margin="28,12,0,4" />
                            <DockPanel Margin="28,0,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseSyncFolder" />
                                <TextBox x:Name="SyncFolder" AutomationProperties.Name="Sync folder" />
                            </DockPanel>
                            <TextBlock x:Name="SyncStatusText" Style="{StaticResource Status}" Margin="28,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Backup" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Back up or restore" Style="{StaticResource Title}" />
                            <TextBlock Text="One file with your settings, folders, alerts, filters, saved searches, user notes and reading history. Your Reddit sign-in isn't included: on another PC you sign in again."
                                       Style="{StaticResource Help}" />
                            <CheckBox x:Name="BackupLibrary" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Back up…" Click="OnBackUp" />
                                <Button Content="Restore…" Margin="8,0,0,0" Click="OnRestore" />
                            </StackPanel>
                            <TextBlock x:Name="BackupStatus" Style="{StaticResource Status}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Updates ==== -->
            <ScrollViewer x:Name="PageUpdates" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Updates" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource PageIntro}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutoUpdate" Content="Update automatically" />
                            <TextBlock Text="Checks every few hours and installs when Skein closes." Style="{StaticResource CheckHelp}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Update source" Style="{StaticResource Title}" />
                            <TextBlock Text="The GitHub repository Skein's releases come from. You won't usually need to change this." Style="{StaticResource Help}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Check now" Margin="8,0,0,0" Click="OnCheckUpdates" />
                                <TextBox x:Name="UpdateUrl" AutomationProperties.Name="Update source" />
                            </DockPanel>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Status}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Help ==== -->
            <ScrollViewer x:Name="PageHelp" Style="{StaticResource Page}">
                <StackPanel MaxWidth="820">
                    <TextBlock Text="Help" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Press ? anywhere in Skein for every keyboard shortcut." Style="{StaticResource PageIntro}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="🐞 Report a problem…" VerticalAlignment="Center" Click="OnReportProblem" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Something not working?" Style="{StaticResource Title}" />
                                <TextBlock Text="Makes a report with Skein's logs (personal details removed) and opens a GitHub issue." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open website" VerticalAlignment="Center" Click="OnOpenWebsite" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Skein's website" Style="{StaticResource Title}" />
                                <TextBlock Text="Downloads, screenshots and what's new." Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Save / Cancel -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#20808080" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save" MinWidth="96" IsDefault="True" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" />
                    <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock Text="Changes apply when you save." Opacity="0.6" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
