<Window x:Class="Skein.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences" Width="560" Height="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" MinWidth="90" IsDefault="True" Click="OnSave"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Theme" VerticalAlignment="Center" />
                    <ComboBox x:Name="Theme" Grid.Column="1" />

                    <TextBlock Grid.Row="1" Text="Accent colour" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox x:Name="Accent" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />

                    <TextBlock Grid.Row="2" Text="Post text size" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Value, ElementName=ReadingSize, StringFormat={}{0:0}px}" />
                        <Slider x:Name="ReadingSize" Minimum="12" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="3" Text="Interface size" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Value, ElementName=UiScale, StringFormat={}{0:0}%}" />
                        <Slider x:Name="UiScale" Minimum="80" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>

                <TextBlock Text="Content" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <CheckBox x:Name="BlurNsfw" Content="Blur NSFW and spoiler images until clicked" Margin="0,8,0,0" />
                <CheckBox x:Name="HideNsfw" Content="Hide NSFW posts in Home, Popular, All and search" Margin="0,4,0,0" />
                <CheckBox x:Name="HideRead" Content="Hide posts I've already opened" Margin="0,4,0,0" />
                <CheckBox x:Name="CheckForNewPosts" Content="Check the open feed for new posts every 90 seconds" Margin="0,4,0,0" />
                <CheckBox x:Name="OpenLinksInApp" Content="Open links inside Skein (instead of your default browser)" Margin="0,4,0,0" />
                <CheckBox x:Name="HideDuplicates" Margin="0,4,0,0"
                          Content="Show a link posted in several communities once (in Home, Popular, All, folders and search)" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Let background tabs sleep (to save memory) after" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="SleepTabs" MinWidth="120" HorizontalAlignment="Left">
                        <ComboBoxItem Content="5 minutes" Tag="5" />
                        <ComboBoxItem Content="15 minutes" Tag="15" />
                        <ComboBoxItem Content="30 minutes" Tag="30" />
                        <ComboBoxItem Content="1 hour" Tag="60" />
                        <ComboBoxItem Content="Never" Tag="0" />
                    </ComboBox>
                </DockPanel>

                <TextBlock Text="Library and inbox" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <CheckBox x:Name="SaveOffline" Content="Keep an offline copy of posts I save" Margin="0,8,0,0" />
                <CheckBox x:Name="InboxNotifications" Content="Notify me about new replies and messages" Margin="0,4,0,0" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="When I close the window" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="CloseAction" MinWidth="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Ask me" Tag="Ask" />
                        <ComboBoxItem Content="Minimize to tray" Tag="Tray" />
                        <ComboBoxItem Content="Exit Skein" Tag="Exit" />
                    </ComboBox>
                </DockPanel>

                <TextBlock Text="Links from other apps" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"
                           Text="Make Skein the app Windows uses for web links. Reddit links (from Discord, email, anywhere) then open in Skein, and every other link goes straight on to your usual browser." />
                <TextBlock x:Name="LinkHandlerStatus" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="LinkHandlerSetUp" Content="Set up…" Click="OnSetUpLinkHandler" />
                    <Button x:Name="LinkHandlerUndo" Content="Stop opening links" Margin="8,0,0,0" Click="OnUndoLinkHandler" />
                </StackPanel>

                <TextBlock Text="Smart filters" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hide posts scoring below (blank = off)" VerticalAlignment="Center" />
                    <TextBox x:Name="MinScore" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="Collapse comments scoring at or below (blank = off)"
                               VerticalAlignment="Center" Margin="0,6,0,0" />
                    <TextBox x:Name="CollapseBelow" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" />
                </Grid>

                <TextBlock Text="Muted users (posts hidden, comments collapsed)" Margin="0,12,0,4" />
                <TextBox x:Name="MutedUsers" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Highlighted users (posts tagged, comments stand out)" Margin="0,12,0,4" />
                <TextBox x:Name="HighlightedUsers" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"
                           Text="Applied to Home, Popular, All, multireddits and search. One entry per line." />

                <TextBlock Text="Hide titles containing" Margin="0,12,0,4" />
                <TextBox x:Name="Keywords" AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Hide links to domains (e.g. example.com)" Margin="0,12,0,4" />
                <TextBox x:Name="Domains" AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Hide subreddits" Margin="0,12,0,4" />
                <TextBox x:Name="Subreddits" AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <TextBlock Text="Save downloaded images and videos to" Margin="0,8,0,4" />
                <TextBox x:Name="DownloadFolder" />

                <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <TextBlock x:Name="VersionText" Opacity="0.75" Margin="0,4,0,0" />
                <CheckBox x:Name="AutoUpdate" Margin="0,8,0,0"
                          Content="Update automatically (checks every few hours, installs when Skein closes)" />
                <TextBlock Text="Update source (GitHub repository URL)" Margin="0,8,0,4" />
                <DockPanel>
                    <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Check now" Margin="8,0,0,0" Click="OnCheckUpdates" />
                    <TextBox x:Name="UpdateUrl" />
                </DockPanel>
                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Opacity="0.85" Margin="0,6,0,0" />

                <TextBlock Text="Sync between PCs" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <CheckBox x:Name="SyncEnabled" Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Text="Keep folders, alerts, user notes, filters and appearance the same on every PC that uses this folder" />
                </CheckBox>
                <TextBlock Text="Sync folder (a OneDrive folder works well)" Margin="0,8,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseSyncFolder" />
                    <TextBox x:Name="SyncFolder" />
                </DockPanel>
                <TextBlock x:Name="SyncStatusText" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" />

                <TextBlock Text="Backup" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"
                           Text="One file with your settings, folders, alerts, filters, saved searches, user notes and reading history. Your Reddit sign-in isn't included: on another PC you sign in again." />
                <CheckBox x:Name="BackupLibrary" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Back up…" Click="OnBackUp" />
                    <Button Content="Restore…" Margin="8,0,0,0" Click="OnRestore" />
                </StackPanel>
                <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0" />

                <TextBlock Text="Help" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Content="🐞 Report a problem…" Click="OnReportProblem" />
                    <TextBlock Text="Makes a report with Skein's logs (personal details removed) and opens a GitHub issue."
                               TextWrapping="Wrap" Opacity="0.7" Margin="12,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
